{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.chqcal.org/publisher/feed.schema.json",
  "title": "CHQ-Orbit Event Publisher Feed",
  "type": "object",
  "required": ["formatVersion", "publisher", "events"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "publisher": { "$ref": "#/$defs/Publisher" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/Event" } }
  },
  "$defs": {
    "IsoDateTimeWithOffset": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Publisher": {
      "type": "object",
      "required": ["id", "name", "contactEmail"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "contactEmail": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "Venue": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "Attachment": {
      "type": "object",
      "required": ["url", "type", "isImage"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "type": { "type": "string" },
        "isImage": { "type": "boolean" }
      }
    },
    "Event": {
      "type": "object",
      "required": ["id", "title", "startDate", "endDate", "category", "lastModified"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "startDate": { "$ref": "#/$defs/IsoDateTimeWithOffset" },
        "endDate": { "$ref": "#/$defs/IsoDateTimeWithOffset" },
        "category": { "type": "string", "minLength": 1 },
        "lastModified": { "$ref": "#/$defs/IsoDateTimeWithOffset" },
        "status": { "enum": ["scheduled", "cancelled", "rescheduled"] },
        "description": { "type": "string" },
        "venueId": { "type": "string" },
        "venue": { "$ref": "#/$defs/Venue" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "presenter": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "cost": { "type": "string" },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/Attachment" } }
      }
    }
  }
}
