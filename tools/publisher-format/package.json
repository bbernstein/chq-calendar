{
  "name": "@chq-calendar/publisher-format",
  "version": "0.1.0",
  "description": "Format definition, schema, and validator for CHQ-orbit event publisher feeds",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "chq-validate-feed": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "copy-schema": "cp src/feed.schema.json ../../docs/publisher/feed.schema.json",
    "copy-refs": "mkdir -p dist/refs && cp ../../docs/publisher/categories.json ../../docs/publisher/venues.json dist/refs/",
    "build": "tsc && npm run copy-schema && npm run copy-refs",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "validate": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.0.0-rc.12",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.0.0"
  }
}
